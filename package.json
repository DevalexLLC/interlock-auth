{
  "name": "@devalexllc/interlock-auth",
  "version": "0.1.0",
  "description": "Better Auth wiring and claim normalization for Interlock, with Next.js and React session clients.",
  "keywords": [
    "better-auth",
    "bff",
    "keycloak",
    "nextjs",
    "react",
    "session"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevalexLLC/interlock-auth.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "changeset": "changeset",
    "clean": "rm -rf dist",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --coverage --ui",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "demo": "vite --config demo/vite.config.ts"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "better-auth": "1.7.7",
    "jsdom": "28.0.0",
    "kysely": "0.29.6",
    "lefthook": "2.1.9",
    "oxfmt": "0.74.0",
    "oxlint": "1.69.0",
    "oxlint-tsgolint": "0.23.0",
    "pg": "8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "better-auth": "1.7.7",
    "kysely": "^0.29.0",
    "react": ">=18.3.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.10.1"
}
